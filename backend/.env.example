# Copier ce fichier en backend/.env puis remplir les valeurs. Ne jamais commiter .env.

# dev = avec Supabase PostgreSQL | nodb = sans base (démarrage initial) | prod = production
SPRING_PROFILES_ACTIVE=nodb
SERVER_PORT=8080

# --- Supabase : projet -----------------------------------------------------
# Dashboard Supabase > Project Settings > API (ou Data API).
SUPABASE_URL=https://<project-ref>.supabase.co
# Clé SECRÈTE serveur : "Secret key" (sb_secret_…) ou ancienne clé "service_role".
# Elle contourne la sécurité RLS : backend uniquement, jamais dans le frontend.
SUPABASE_SECRET_KEY=

# --- Supabase : PostgreSQL -------------------------------------------------
# Dashboard > bouton "Connect" > onglet JDBC, mode "Session pooler" (compatible IPv4).
# Éviter le "Transaction pooler" (port 6543) : incompatible avec les requêtes préparées de Hibernate.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_POOL_SIZE=5

# --- Supabase : Storage ----------------------------------------------------
# Bucket privé créé automatiquement au démarrage s'il n'existe pas.
SUPABASE_STORAGE_BUCKET=lisa-cosmetique
SUPABASE_SIGNED_URL_TTL=15m

# --- CORS ------------------------------------------------------------------
# Origines du frontend, séparées par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Administration --------------------------------------------------------
# Crée le premier compte ADMIN au démarrage s'il n'existe pas. 8 caractères minimum.
# À retirer une fois le compte créé. Ne jamais commiter de vrai mot de passe.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Documentation API -----------------------------------------------------
SWAGGER_ENABLED=true
